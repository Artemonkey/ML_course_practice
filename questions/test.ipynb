    "X = np.array([[1,-4],[1,-3],[1,-1],[1,1],[1,3]])\n",
    "Y = np.array([-16.95,-12.24,-2.82,6.6,16.02])\n",
    "X_T = np.linalg.matrix_transpose(X)\n",
    "\n",
    "D = np.dot(np.dot(np.linalg.inv(np.dot(X_T,X)),X_T),Y)\n",
    "print(D)"
